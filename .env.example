# Supabase — projeto do NEXO Jurídico.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Somente no servidor. Nunca prefixar com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Chave usada para cifrar a credencial de IA salva em global_ai_settings
# (32 bytes em base64, ex: `openssl rand -base64 32`). Somente no servidor.
AI_SETTINGS_ENCRYPTION_KEY=

# URL pública do app (usada em links de convite/redefinição de senha).
NEXT_PUBLIC_APP_URL=http://localhost:3000
